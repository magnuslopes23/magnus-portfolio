# Public site URL used by metadata, sitemap and canonical links.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Contact form delivery via Resend's HTTP API.
# Create a key and verify your sending domain before production use.
RESEND_API_KEY=re_xxxxxxxxx
CONTACT_TO_EMAIL=hello@your-domain.com
CONTACT_FROM_EMAIL=Portfolio <portfolio@your-domain.com>
